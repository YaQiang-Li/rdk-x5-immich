     ctx->api = x265_api_get(desc->comp[0].depth);
     if (!ctx->api)
         ctx->api = x265_api_get(0);
@@ -677,6 +735,10 @@ static int libx265_encode_frame(AVCodecContext *avctx, AVPacket *pkt,
     int ret;
     int i;
 
+#if CONFIG_X5MM
+    if (ctx->x5)
+        return ff_x5enc_encode(avctx, ctx->x5, pkt, pic, got_packet);
+#endif
     ctx->api->picture_init(ctx->params, &x265pic);
 
     sei = &x265pic.userSEI;
diff --git a/libavcodec/x5dec.c b/libavcodec/x5dec.c
new file mode 100644
index 0000000..f85a171
--- /dev/null
+++ b/libavcodec/x5dec.c
@@ -0,0 +1,692 @@
+/*
+ * RDK X5 hardware decoder (H.264/HEVC on VPU, MJPEG on JPU)
+ * through D-Robotics libmultimedia (hb_mm_mc_* API).
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <hb_media_codec.h>
+#include <hb_media_error.h>
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "config_components.h"
+
+#include "libavutil/imgutils.h"
+#include "libavutil/mem.h"
+#include "avcodec.h"
+#include "bsf.h"
+#include "codec_internal.h"
+#include "decode.h"
+#include "internal.h"
+
+#define X5DEC_TIMEOUT_MS   5000
+#define X5DEC_MAX_PTS      64
+/* packets kept since the last keyframe, to replay into the fallback */
+#define X5DEC_MAX_REPLAY   600
+/* packets taken from libavcodec but not yet queued to the hardware */
+#define X5DEC_MAX_PENDING  32
+
+typedef struct X5DecContext {
+    const AVClass *class;
+    /* software fallback: set when the hardware cannot take the stream */
+    AVCodecContext *sw;
+    media_codec_context_t mc;
+    int started;
+    /*
+     * Packets are always taken from libavcodec right away, so its single
+     * packet slot is free and avcodec_send_packet() never returns EAGAIN
+     * (OpenCV, for one, drops the packet when it does).
+     */
+    AVPacket *pending[X5DEC_MAX_PENDING];
+    int nb_pending;
+    /*
+     * Like the native decoders, return at most one frame per packet taken
+     * (except while draining). Callers such as OpenCV 4.5 lose the pts of a
+     * frame that is ready before they send the next packet.
+     */
+    int may_output;
+    int eos_pending;    /* EOF taken from libavcodec, not yet queued */
+    int eos_sent;
+    int eos;
+    AVPacket *pkt;
+    /*
+     * The hardware tags each output frame with the pts of the packet
+     * decoded at that step (decode order), not of the displayed frame.
+     * Frames come out in display order, so the display pts is always
+     * the smallest pts still pending.
+     */
+    int64_t pts[X5DEC_MAX_PTS];
+    int64_t dur[X5DEC_MAX_PTS];  /* packet duration, for VFR streams */
+    int nb_pts;
+    /*
+     * Mid-stream fallback: the library may accept an instance and only fail
+     * later (e.g. out of ION memory with many instances). Keep the packets
+     * since the last keyframe, replay them into a software decoder and drop
+     * the frames that were already returned.
+     */
+    AVPacket *replay[X5DEC_MAX_REPLAY];
+    int nb_replay, replay_pos, replay_eos;
+    int64_t last_pts;
+    int64_t nb_out, nb_sent, sent_at_key, drop;
+} X5DecContext;
+
+static void x5dec_pending_reset(X5DecContext *s)
+{
+    while (s->nb_pending)
+        av_packet_free(&s->pending[--s->nb_pending]);
+}
+
+/* move the oldest pending packet into s->pkt */
+static void x5dec_pending_pop(X5DecContext *s)
+{
+    av_packet_move_ref(s->pkt, s->pending[0]);
+    av_packet_free(&s->pending[0]);
+    memmove(s->pending, s->pending + 1, --s->nb_pending * sizeof(*s->pending));
+}
+
+static void x5dec_replay_reset(X5DecContext *s)
+{
+    while (s->nb_replay)
+        av_packet_free(&s->replay[--s->nb_replay]);
+    s->replay_pos = 0;
+}
+
+static void x5dec_replay_add(X5DecContext *s, const AVPacket *pkt)
+{
+    if (pkt->flags & AV_PKT_FLAG_KEY) {
+        x5dec_replay_reset(s);
+        s->sent_at_key = s->nb_sent;
+    }
+    /* overflow: the fallback will resync at the next keyframe */
+    if (s->nb_replay < X5DEC_MAX_REPLAY)
+        s->replay[s->nb_replay++] = av_packet_clone(pkt);
+}
+
+static void x5dec_push_pts(X5DecContext *s, const AVPacket *pkt)
+{
+    if (pkt->pts == AV_NOPTS_VALUE || s->nb_pts == X5DEC_MAX_PTS)
+        return;
+    s->pts[s->nb_pts] = pkt->pts;
+    s->dur[s->nb_pts] = pkt->duration;
+    s->nb_pts++;
+}
+
+/* sets the pts and duration of the picture that is displayed next */
+static void x5dec_pop_pts(X5DecContext *s, AVFrame *frame)
+{
+    int i, min = 0;
+
+    if (!s->nb_pts) {
+        frame->pts = AV_NOPTS_VALUE;
+        return;
+    }
+    for (i = 1; i < s->nb_pts; i++)
+        if (s->pts[i] < s->pts[min])
+            min = i;
+    frame->pts      = s->pts[min];
+    frame->duration = s->dur[min];
+    s->nb_pts--;
+    s->pts[min] = s->pts[s->nb_pts];
+    s->dur[min] = s->dur[s->nb_pts];
+}
+
+static av_cold int x5dec_close(AVCodecContext *avctx)
+{
+    X5DecContext *s = avctx->priv_data;
+
+    if (s->started) {
+        hb_mm_mc_stop(&s->mc);
+        hb_mm_mc_release(&s->mc);
+        s->started = 0;
+    }
+    av_packet_free(&s->pkt);
+    avcodec_free_context(&s->sw);
+    x5dec_replay_reset(s);
+    x5dec_pending_reset(s);
+    return 0;
+}
+
+/* X5_CODEC_DISABLE=1 forces the software path, for comparison and debug */
+static int x5dec_disabled(void)
+{
+    const char *e = getenv("X5_CODEC_DISABLE");
+
+    return e && *e && strcmp(e, "0");
+}
+
+/* the VPU/JPU only do 8-bit 4:2:0; AV_PIX_FMT_NONE means not probed yet */
+static int x5dec_hw_usable(AVCodecContext *avctx)
+{
+    if (x5dec_disabled() || avctx->lowres)
+        return 0;
+    /*
+     * Keyframe-only decoding (e.g. thumbnails with -skip_frame nointra) is
+     * cheap on the CPU, while the hardware has to decode every frame.
+     */
+    if (avctx->skip_frame >= AVDISCARD_NONINTRA)
+        return 0;
+    return avctx->pix_fmt == AV_PIX_FMT_NONE ||
+           avctx->pix_fmt == AV_PIX_FMT_YUV420P ||
+           avctx->pix_fmt == AV_PIX_FMT_YUVJ420P;
+}
+
+static av_cold int x5dec_init_sw(AVCodecContext *avctx)
+{
+    X5DecContext *s = avctx->priv_data;
+    const char *name = avctx->codec_id == AV_CODEC_ID_H264 ? "h264" :
+                       avctx->codec_id == AV_CODEC_ID_HEVC ? "hevc" : "mjpeg";
+    const AVCodec *c = avcodec_find_decoder_by_name(name);
+    int ret;
+
+    if (!c)
+        return AVERROR_DECODER_NOT_FOUND;
+    s->sw = avcodec_alloc_context3(c);
+    if (!s->sw)
+        return AVERROR(ENOMEM);
+    /* packets arrive through our Annex B filter: take its output params */
+    ret = avcodec_parameters_to_context(s->sw, avctx->internal->bsf->par_out);
+    if (ret < 0)
+        return ret;
+    s->sw->pkt_timebase      = avctx->pkt_timebase;
+    s->sw->thread_count      = avctx->thread_count;
+    s->sw->thread_type       = avctx->thread_type;
+    s->sw->flags             = avctx->flags;
+    s->sw->flags2            = avctx->flags2;
+    s->sw->skip_frame        = avctx->skip_frame;
+    s->sw->skip_loop_filter  = avctx->skip_loop_filter;
+    s->sw->err_recognition   = avctx->err_recognition;
+    s->sw->workaround_bugs   = avctx->workaround_bugs;
+    s->sw->strict_std_compliance = avctx->strict_std_compliance;
+    return avcodec_open2(s->sw, c, NULL);
+}
+
+/*
+ * The decoder emits nothing until it holds a full DPB of input, so the
+ * input queue must be deeper than the largest DPB the stream may use:
+ * derive it from level and picture size (H.264 table A-1, HEVC A.4.2).
+ */
+static int x5dec_dpb_frames(AVCodecContext *avctx, int w, int h)
+{
+    static const struct { int level, max_dpb_mbs; } h264[] = {
+        {  9,    396 }, { 10,    396 }, { 11,    900 }, { 12,   2376 },
+        { 13,   2376 }, { 20,   2376 }, { 21,   4752 }, { 22,   8100 },
+        { 30,   8100 }, { 31,  18000 }, { 32,  20480 }, { 40,  32768 },
+        { 41,  32768 }, { 42,  34816 }, { 50, 110400 }, { 51, 184320 },
+        { 52, 184320 }, { 60, 696320 }, { 61, 696320 }, { 62, 696320 },
+    };
+    static const struct { int level, max_luma_ps; } hevc[] = {
+        {  30,    36864 }, {  60,   122880 }, {  63,   245760 },
+        {  90,   552960 }, {  93,   983040 }, { 120,  2228224 },
+        { 123,  2228224 }, { 150,  8912896 }, { 153,  8912896 },
+        { 156,  8912896 }, { 180, 35651584 }, { 183, 35651584 },
+        { 186, 35651584 },
+    };
+    int i;
+
+    if (avctx->codec_id == AV_CODEC_ID_H264) {
+        int mbs = ((w + 15) / 16) * ((h + 15) / 16);
+
+        for (i = 0; i < FF_ARRAY_ELEMS(h264); i++)
+            if (h264[i].level == avctx->level)
+                return av_clip(h264[i].max_dpb_mbs / mbs, 1, 16);
+    } else if (avctx->codec_id == AV_CODEC_ID_HEVC) {
+        int64_t ps = (int64_t)w * h;
+
+        for (i = 0; i < FF_ARRAY_ELEMS(hevc); i++) {
+            int64_t max = hevc[i].max_luma_ps;
+
+            if (hevc[i].level != avctx->level)
+                continue;
+            return ps <= max / 4 ? 16 : ps <= max / 2 ? 12 :
+                   ps <= max * 3 / 4 ? 8 : 6;
+        }
+    } else {
+        return 1;
+    }
+    /* level unknown: assume the worst the CMA budget allows */
+    return (int64_t)w * h <= 1920 * 1088 ? 16 : 8;
+}
+
+static av_cold int x5dec_init_hw(AVCodecContext *avctx)
+{
+    X5DecContext *s = avctx->priv_data;
+    mc_video_codec_dec_params_t *p = &s->mc.video_dec_params;
+    mc_av_codec_startup_params_t startup = { 0 };
+    int w = avctx->width  > 0 ? avctx->width  : 3840;
+    int h = avctx->height > 0 ? avctx->height : 2160;
+    int ret;
+
+    memset(&s->mc, 0, sizeof(s->mc));
+    s->mc.encoder = 0;
+    p->feed_mode           = MC_FEEDING_MODE_FRAME_SIZE;
+    p->pix_fmt             = MC_PIXEL_FORMAT_YUV420P;
+    /* 8 bits per pixel is far above any real compressed picture */
+    p->bitstream_buf_size  = FFALIGN(w * h, 0x400);
+    p->bitstream_buf_count = FFMAX(3, x5dec_dpb_frames(avctx, w, h) + 2);
+    /*
+     * With fewer output buffers than queued inputs the decoder holds the VPU
+     * core while it waits for a free buffer, and an encoder in the same
+     * process can no longer get its input buffers (dequeue times out).
+     */
+    p->frame_buf_count     = FFMAX(3, p->bitstream_buf_count - 2);
+
+    switch (avctx->codec_id) {
+    case AV_CODEC_ID_H264:
+        s->mc.codec_id = MEDIA_CODEC_ID_H264;
+        p->h264_dec_config.bandwidth_Opt  = 1;
+        p->h264_dec_config.reorder_enable = 1;
+        break;
+    case AV_CODEC_ID_HEVC:
+        s->mc.codec_id = MEDIA_CODEC_ID_H265;
+        p->h265_dec_config.bandwidth_Opt  = 1;
+        p->h265_dec_config.reorder_enable = 1;
+        break;
+    default:
+        s->mc.codec_id = MEDIA_CODEC_ID_MJPEG;
+        p->mjpeg_dec_config.rot_degree    = MC_CCW_0;
+        p->mjpeg_dec_config.mir_direction = MC_DIRECTION_NONE;
+        break;
+    }
+
+    ret = hb_mm_mc_initialize(&s->mc);
+    if (ret) {
+        av_log(avctx, AV_LOG_VERBOSE, "hb_mm_mc_initialize: 0x%x\n", ret);
+        return AVERROR_EXTERNAL;
+    }
+    ret = hb_mm_mc_configure(&s->mc);
+    if (!ret)
+        ret = hb_mm_mc_start(&s->mc, &startup);
+    if (ret) {
+        av_log(avctx, AV_LOG_VERBOSE, "configure/start: 0x%x\n", ret);
+        hb_mm_mc_release(&s->mc);
+        return AVERROR_EXTERNAL;
+    }
+    s->started = 1;
+    /* full range streams come out as yuvj420p, like the native decoders */
+    avctx->pix_fmt = avctx->codec_id == AV_CODEC_ID_MJPEG ||
+                     avctx->pix_fmt == AV_PIX_FMT_YUVJ420P ||
+                     avctx->color_range == AVCOL_RANGE_JPEG ?
+                     AV_PIX_FMT_YUVJ420P : AV_PIX_FMT_YUV420P;
+    return 0;
+}
+
+static av_cold int x5dec_init(AVCodecContext *avctx)
+{
+    X5DecContext *s = avctx->priv_data;
+
+    s->last_pts = AV_NOPTS_VALUE;
+    s->pkt = av_packet_alloc();
+    if (!s->pkt)
+        return AVERROR(ENOMEM);
+    if (x5dec_hw_usable(avctx) && x5dec_init_hw(avctx) == 0) {
+        av_log(avctx, AV_LOG_INFO, "using RDK X5 hardware decoder\n");
+        return 0;
+    }
+    av_log(avctx, AV_LOG_INFO, "using software decoder\n");
+    return x5dec_init_sw(avctx);
+}
+
+/* pkt == NULL signals end of stream */
+static int x5dec_send(AVCodecContext *avctx, const AVPacket *pkt)
+{
+    X5DecContext *s = avctx->priv_data;
+    media_codec_buffer_t in = { 0 };
+    int ret;
+
+    in.type = MC_VIDEO_STREAM_BUFFER;
+    ret = hb_mm_mc_dequeue_input_buffer(&s->mc, &in, X5DEC_TIMEOUT_MS);
+    if (ret) {
+        av_log(avctx, AV_LOG_ERROR, "dequeue input: 0x%x\n", ret);
+        return AVERROR_EXTERNAL;
+    }
+    if (pkt && pkt->size > in.vstream_buf.size) {
+        av_log(avctx, AV_LOG_ERROR, "packet %d > stream buffer %u\n",
+               pkt->size, in.vstream_buf.size);
+        in.vstream_buf.size = 0;
+        hb_mm_mc_queue_input_buffer(&s->mc, &in, X5DEC_TIMEOUT_MS);
+        return AVERROR_EXTERNAL;
+    }
+    in.type = MC_VIDEO_STREAM_BUFFER;
+    if (pkt) {
+        memcpy(in.vstream_buf.vir_ptr, pkt->data, pkt->size);
+        in.vstream_buf.size       = pkt->size;
+        /* raw Annex B input has dts only */
+        x5dec_push_pts(s, pkt);
+        in.vstream_buf.stream_end = 0;
+    } else {
+        in.vstream_buf.size       = 0;
+        in.vstream_buf.stream_end = 1;
+    }
+    ret = hb_mm_mc_queue_input_buffer(&s->mc, &in, X5DEC_TIMEOUT_MS);
+    if (ret) {
+        av_log(avctx, AV_LOG_ERROR, "queue input: 0x%x\n", ret);
+        return AVERROR_EXTERNAL;
+    }
+    return 0;
+}
+
+static int x5dec_output(AVCodecContext *avctx, AVFrame *frame,
+                        const media_codec_buffer_t *out,
+                        const media_codec_output_buffer_info_t *info)
+{
+    X5DecContext *s = avctx->priv_data;
+    const mc_video_frame_buffer_info_t *vf = &out->vframe_buf;
+    int w, h, ret;
+
+    if (avctx->codec_id == AV_CODEC_ID_MJPEG) {
+        w = info->jpeg_frame_info.display_width;
+        h = info->jpeg_frame_info.display_height;
+    } else {
+        w = info->video_frame_info.display_width;
+        h = info->video_frame_info.display_height;
+    }
+    if (w <= 0 || h <= 0) {
+        w = vf->width;
+        h = vf->height;
+    }
+    if (w != avctx->width || h != avctx->height) {
+        ret = ff_set_dimensions(avctx, w, h);
+        if (ret < 0)
+            return ret;
+    }
+    ret = ff_get_buffer(avctx, frame, 0);
+    if (ret < 0)
+        return ret;
+
+    /* I420 output: vstride is the chroma stride */
+    av_image_copy_plane(frame->data[0], frame->linesize[0],
+                        vf->vir_ptr[0], vf->stride, w, h);
+    av_image_copy_plane(frame->data[1], frame->linesize[1],
+                        vf->vir_ptr[1], vf->vstride, (w + 1) / 2,
+                        (h + 1) / 2);
+    av_image_copy_plane(frame->data[2], frame->linesize[2],
+                        vf->vir_ptr[2], vf->vstride, (w + 1) / 2,
+                        (h + 1) / 2);
+    /* like the native decoders: no packet pts -> no frame pts */
+    x5dec_pop_pts(s, frame);
+    /*
+     * ff_get_buffer() copied the dts of the newest packet, a whole pipeline
+     * ahead of this picture. Use the pts instead: it is monotonic in output
+     * order, and callers like OpenCV read pkt_dts when pts is 0.
+     */
+    frame->pkt_dts = frame->pts;
+    return 0;
+}
+
+/*
+ * Dequeue one output buffer (blocking). Returns 0 with a frame,
+ * AVERROR(EAGAIN) if the buffer carried no picture, AVERROR_EOF once the
+ * empty frame_end buffer that follows stream_end has been seen.
+ */
+static int x5dec_get_frame(AVCodecContext *avctx, AVFrame *frame)
+{
+    X5DecContext *s = avctx->priv_data;
+    media_codec_buffer_t out = { 0 };
+    media_codec_output_buffer_info_t info = { 0 };
+    int ret, valid;
+
+    if (s->eos)
+        return AVERROR_EOF;
+    ret = hb_mm_mc_dequeue_output_buffer(&s->mc, &out, &info,
+                                         X5DEC_TIMEOUT_MS);
+    if (ret) {
+        av_log(avctx, AV_LOG_ERROR, "dequeue output: 0x%x\n", ret);
+        return AVERROR_EXTERNAL;
+    }
+    if (out.vframe_buf.frame_end && !out.vframe_buf.size)
+        s->eos = 1;
+    valid = out.type == MC_VIDEO_FRAME_BUFFER &&
+            out.vframe_buf.size > 0 &&
+            info.video_frame_info.decode_result != 0;
+    ret = valid ? x5dec_output(avctx, frame, &out, &info) : AVERROR(EAGAIN);
+    if (hb_mm_mc_queue_output_buffer(&s->mc, &out, X5DEC_TIMEOUT_MS))
+        av_log(avctx, AV_LOG_WARNING, "queue output buffer failed\n");
+    return ret;
+}
+
+/*
+ * Keep the hardware input queue full and only block on output when no more
+ * input can be queued (queue full or end of stream). The library has no
+ * non-blocking dequeue (timeout 0 is an error, and a 1 ms timeout costs a
+ * whole 10 ms scheduler tick at HZ=100), so queue levels are read with
+ * hb_mm_mc_get_status() instead of polling.
+ */
+static int x5dec_receive_frame_sw(AVCodecContext *avctx, AVFrame *frame)
+{
+    X5DecContext *s = avctx->priv_data;
+    int ret;
+
+    for (;;) {
+        ret = avcodec_receive_frame(s->sw, frame);
+        if (ret == 0 && s->drop) {
+            /* already returned by the hardware before the switch */
+            if (frame->pts == AV_NOPTS_VALUE || s->last_pts == AV_NOPTS_VALUE ?
+                s->drop-- > 0 : frame->pts <= s->last_pts) {
+                av_frame_unref(frame);
+                continue;
+            }
+            s->drop = 0;
+        }
+        if (ret != AVERROR(EAGAIN))
+            break;
+        if (s->replay_pos < s->nb_replay) {
+            ret = avcodec_send_packet(s->sw, s->replay[s->replay_pos++]);
+            if (s->replay_pos == s->nb_replay)
+                x5dec_replay_reset(s);
+        } else {
+            if (s->replay_eos)
+                ret = AVERROR_EOF;
+            else
+                ret = ff_decode_get_packet(avctx, s->pkt);
+            if (ret < 0 && ret != AVERROR_EOF)
+                return ret;
+            ret = avcodec_send_packet(s->sw,
+                                      ret == AVERROR_EOF ? NULL : s->pkt);
+            av_packet_unref(s->pkt);
+        }
+        if (ret < 0 && ret != AVERROR_EOF)
+            return ret;
+    }
+    if (ret == 0) {
+        /* callers read stream properties from the context, not the frame */
+        avctx->pix_fmt             = s->sw->pix_fmt;
+        avctx->profile             = s->sw->profile;
+        avctx->level               = s->sw->level;
+        avctx->has_b_frames        = s->sw->has_b_frames;
+        avctx->sample_aspect_ratio = s->sw->sample_aspect_ratio;
+        avctx->color_range         = s->sw->color_range;
+        avctx->colorspace          = s->sw->colorspace;
+        avctx->color_primaries     = s->sw->color_primaries;
+        avctx->color_trc           = s->sw->color_trc;
+        avctx->chroma_sample_location = s->sw->chroma_sample_location;
+        if (s->sw->width != avctx->width || s->sw->height != avctx->height)
+            ret = ff_set_dimensions(avctx, s->sw->width, s->sw->height);
+    }
+    return ret;
+}
+
+static int x5dec_receive_frame_hw(AVCodecContext *avctx, AVFrame *frame)
+{
+    X5DecContext *s = avctx->priv_data;
+    int ret;
+
+    for (;;) {
+        mc_inter_status_t st = { 0 };
+        int have, room;
+
+        /*
+         * Always take the packet libavcodec buffered, even if a frame is
+         * ready: otherwise the next avcodec_send_packet() returns EAGAIN,
+         * which callers such as OpenCV treat as an error and drop the packet.
+         */
+        while (!s->eos_pending && !s->eos_sent &&
+               s->nb_pending < X5DEC_MAX_PENDING) {
+            ret = ff_decode_get_packet(avctx, s->pkt);
+            if (ret == AVERROR_EOF)
+                s->eos_pending = 1;
+            else if (ret < 0 && ret != AVERROR(EAGAIN))
+                return ret;
+            if (ret < 0)
+                break;
+            s->pending[s->nb_pending] = av_packet_alloc();
+            if (!s->pending[s->nb_pending])
+                return AVERROR(ENOMEM);
+            av_packet_move_ref(s->pending[s->nb_pending++], s->pkt);
+            s->may_output = 1;
+        }
+        if (!s->may_output && !s->eos_pending && !s->eos_sent)
+            return AVERROR(EAGAIN);
+        have = s->nb_pending || s->eos_pending;
+
+        ret = hb_mm_mc_get_status(&s->mc, &st);
+        if (ret) {
+            av_log(avctx, AV_LOG_ERROR, "get status: 0x%x\n", ret);
+            return AVERROR_EXTERNAL;
+        }
+        room = st.cur_input_buf_cnt <
+               s->mc.video_dec_params.bitstream_buf_count;
+
+        if (have && room && !st.cur_output_buf_cnt) {
+            if (s->nb_pending) {
+                x5dec_pending_pop(s);
+                x5dec_replay_add(s, s->pkt);
+                ret = x5dec_send(avctx, s->pkt);
+                s->nb_sent++;
+                av_packet_unref(s->pkt);
+            } else {
+                ret = x5dec_send(avctx, NULL);
+                s->eos_sent = 1;
+                s->eos_pending = 0;
+            }
+            if (ret < 0)
+                return ret;
+            continue;
+        }
+        /* nothing to decode yet: ask for more input */
+        if (!have && room && !st.cur_output_buf_cnt && !s->eos_sent)
+            return AVERROR(EAGAIN);
+
+        /*
+         * Drained: the empty frame_end buffer only follows stream_end when
+         * frames were still held for reordering, so check the counters.
+         */
+        if (s->eos_sent && !st.cur_input_buf_cnt && !st.cur_output_buf_cnt &&
+            st.total_output_buf_cnt >= st.total_input_buf_cnt)
+            return AVERROR_EOF;
+
+        /* a frame is ready, the input queue is full or the stream ended */
+        ret = x5dec_get_frame(avctx, frame);
+        if (ret == 0) {
+            s->may_output = 0;
+            s->nb_out++;
+            if (frame->pts != AV_NOPTS_VALUE)
+                s->last_pts = frame->pts;
+        }
+        if (ret != AVERROR(EAGAIN))
+            return ret;
+    }
+}
+
+static int x5dec_receive_frame(AVCodecContext *avctx, AVFrame *frame)
+{
+    X5DecContext *s = avctx->priv_data;
+    int ret;
+
+    if (!s->sw) {
+        ret = x5dec_receive_frame_hw(avctx, frame);
+        if (ret != AVERROR_EXTERNAL)
+            return ret;
+        av_log(avctx, AV_LOG_WARNING, "hardware decoder failed, switching "
+               "to software decoding\n");
+        hb_mm_mc_stop(&s->mc);
+        hb_mm_mc_release(&s->mc);
+        s->started = 0;
+        ret = x5dec_init_sw(avctx);
+        if (ret < 0)
+            return ret;
+        /* without pts: frames output since the keyframe was queued */
+        s->drop = FFMAX(s->nb_out - s->sent_at_key, 0);
+        if (s->last_pts != AV_NOPTS_VALUE)
+            s->drop = 1;
+        /* packets held back for the hardware go to software too */
+        while (s->nb_pending) {
+            x5dec_pending_pop(s);
+            x5dec_replay_add(s, s->pkt);
+            av_packet_unref(s->pkt);
+        }
+        s->replay_eos = s->eos_sent || s->eos_pending;
+    }
+    return x5dec_receive_frame_sw(avctx, frame);
+}
+
+/* seek: restart the hardware instance, there is no reset in the API */
+static void x5dec_flush(AVCodecContext *avctx)
+{
+    X5DecContext *s = avctx->priv_data;
+
+    x5dec_replay_reset(s);
+    x5dec_pending_reset(s);
+    av_packet_unref(s->pkt);
+    s->nb_pts = s->drop = 0;
+    s->nb_out = s->nb_sent = s->sent_at_key = 0;
+    s->last_pts = AV_NOPTS_VALUE;
+    s->eos_pending = s->eos_sent = s->eos = s->replay_eos = 0;
+    s->may_output = 0;
+    if (s->sw) {
+        avcodec_flush_buffers(s->sw);
+        return;
+    }
+    if (s->started) {
+        hb_mm_mc_stop(&s->mc);
+        hb_mm_mc_release(&s->mc);
+        s->started = 0;
+    }
+    if (x5dec_init_hw(avctx) < 0 && x5dec_init_sw(avctx) < 0)
+        av_log(avctx, AV_LOG_ERROR, "decoder restart after flush failed\n");
+}
+
+#define X5DEC(NAME, LONGNAME, ID, BSFS)                                     \
+    static const AVClass x5_##NAME##_dec_class = {                          \
+        .class_name = #NAME "_x5_decoder",                                  \
+        .item_name  = av_default_item_name,                                 \
+        .version    = LIBAVUTIL_VERSION_INT,                                \
+    };                                                                      \
+    const FFCodec ff_##NAME##_x5_decoder = {                                \
+        .p.name         = #NAME "_x5",                                      \
+        CODEC_LONG_NAME("RDK X5 " LONGNAME                                  \
+                        " hardware decoder (software fallback)"),           \
+        .p.type         = AVMEDIA_TYPE_VIDEO,                               \
+        .p.id           = ID,                                               \
+        .p.priv_class   = &x5_##NAME##_dec_class,                           \
+        .p.capabilities = AV_CODEC_CAP_DELAY | AV_CODEC_CAP_HARDWARE |      \
+                          AV_CODEC_CAP_AVOID_PROBING,                       \
+        .p.wrapper_name = "x5mm",                                           \
+        .priv_data_size = sizeof(X5DecContext),                             \
+        .init           = x5dec_init,                                       \
+        FF_CODEC_RECEIVE_FRAME_CB(x5dec_receive_frame),                     \
+        .flush          = x5dec_flush,                                      \
+        .close          = x5dec_close,                                      \
+        .bsfs           = BSFS,                                             \
+        .caps_internal  = FF_CODEC_CAP_INIT_CLEANUP |                       \
+                          FF_CODEC_CAP_AUTO_THREADS,                        \
+    };
+
+X5DEC(h264,  "H.264", AV_CODEC_ID_H264,  "h264_mp4toannexb")
+X5DEC(hevc,  "HEVC",  AV_CODEC_ID_HEVC,  "hevc_mp4toannexb")
+X5DEC(mjpeg, "MJPEG", AV_CODEC_ID_MJPEG, NULL)
