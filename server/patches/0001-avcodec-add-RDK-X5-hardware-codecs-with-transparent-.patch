 {
     libx265Context *ctx = avctx->priv_data;
@@ -250,6 +304,10 @@ static av_cold int libx265_encode_init(AVCodecContext *avctx)
     const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(avctx->pix_fmt);
