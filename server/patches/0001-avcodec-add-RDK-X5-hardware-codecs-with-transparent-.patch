From 501a5fcdc4c3ed8e48c52a6ba8a33e605bb84284 Mon Sep 17 00:00:00 2001
From: "yaqiang.li" <yaqiang.li@d-robotics.cc>
Date: Sun, 22 Nov 2026 11:44:34 +0800
Subject: [PATCH] avcodec: add RDK X5 hardware codecs with transparent
 libx264/libx265 and decoder fallback

---
 configure              |  11 +
 libavcodec/Makefile    |   1 +
 libavcodec/allcodecs.c |   9 +
 libavcodec/libx264.c   |  66 ++++
 libavcodec/libx265.c   |  62 ++++
 libavcodec/x5dec.c     | 692 +++++++++++++++++++++++++++++++++++++++++
 libavcodec/x5enc.c     | 622 ++++++++++++++++++++++++++++++++++++
 libavcodec/x5enc.h     |  52 ++++
 8 files changed, 1515 insertions(+)
 create mode 100644 libavcodec/x5dec.c
 create mode 100644 libavcodec/x5enc.c
 create mode 100644 libavcodec/x5enc.h

