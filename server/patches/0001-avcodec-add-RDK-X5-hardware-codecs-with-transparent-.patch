diff --git a/libavcodec/libx264.c b/libavcodec/libx264.c
index 409f45f..26d9f5f 100644
--- a/libavcodec/libx264.c
+++ b/libavcodec/libx264.c
@@ -40,6 +40,9 @@
 #include "atsc_a53.h"
 #include "sei.h"
 #include "golomb.h"
+#if CONFIG_X5MM
+#include "x5enc.h"
+#endif
 
 #include <x264.h>
 #include <float.h>
@@ -74,6 +77,9 @@ typedef struct X264Context {
     char *tune;
     const char *profile;
     char *profile_opt;
+#if CONFIG_X5MM
+    struct X5Enc *x5;
+#endif
     char *level;
     int fastfirstpass;
     char *wpredp;
@@ -619,6 +625,10 @@ static int X264_frame(AVCodecContext *ctx, AVPacket *pkt, const AVFrame *frame,
     int64_t wallclock = 0;
     X264Opaque *out_opaque;
 
+#if CONFIG_X5MM
+    if (x4->x5)
+        return ff_x5enc_encode(ctx, x4->x5, pkt, frame, got_packet);
+#endif
     ret = setup_frame(ctx, frame, &pic_in);
     if (ret < 0)
         return ret;
@@ -748,6 +758,12 @@ static void X264_flush(AVCodecContext *avctx)
     int nnal, ret;
     x264_picture_t pic_out = {0};
 
+#if CONFIG_X5MM
+    /* the hardware path holds no frames */
+    if (x4->x5)
+        return;
+#endif
+
     do {
         ret = x264_encoder_encode(x4->enc, &nal, &nnal, NULL, &pic_out);
     } while (ret > 0 && x264_encoder_delayed_frames(x4->enc));
@@ -777,6 +793,9 @@ static av_cold int X264_close(AVCodecContext *avctx)
         x264_encoder_close(x4->enc);
         x4->enc = NULL;
     }
+#if CONFIG_X5MM
+    ff_x5enc_close(&x4->x5);
+#endif
 
     return 0;
 }
@@ -1062,6 +1081,49 @@ static void handle_side_data(AVCodecContext *avctx, x264_param_t *params)
 #endif // CONFIG_LIBX264_HDR10
 }
 
+#if CONFIG_X5MM
+/*
+ * RDK X5: take the hardware encoder when it can honour the request, so
+ * existing x264 users get it without changes. Lossless, non 4:2:0 and
+ * >8-bit input stay on x264. B frames, presets and x264-params are
+ * not available in hardware and are ignored. X5_CODEC_DISABLE=1 forces
+ * x264.
+ */
+static int x264_x5_open(AVCodecContext *avctx)
+{
+    X264Context *x = avctx->priv_data;
+    X5EncParams par = {
+        .qp      = -1,
+        .profile = avctx->profile,
+        .gop     = 250,
+    };
+    int ret;
+
+    if (x->cqp == 0 || x->crf == 0)
+        return AVERROR(ENOSYS);
+    if (avctx->bit_rate <= 0)
+        par.qp = av_clip(x->cqp >= 0 ? x->cqp :
+                         lrintf(x->crf >= 0 ? x->crf : 23), 1, 51);
+    if (x->profile_opt && par.profile == AV_PROFILE_UNKNOWN) {
+        if (!strcmp(x->profile_opt, "baseline"))
+            par.profile = AV_PROFILE_H264_BASELINE;
+        else if (!strcmp(x->profile_opt, "main"))
+            par.profile = AV_PROFILE_H264_MAIN;
+        else if (!strcmp(x->profile_opt, "high"))
+            par.profile = AV_PROFILE_H264_HIGH;
+    }
+    ret = ff_x5enc_open(avctx, &par, &x->x5);
+    if (!ret)
+        av_log(avctx, AV_LOG_INFO, "using RDK X5 hardware encoder; "
+               "x264 options are ignored (X5_CODEC_DISABLE=1 selects "
+               "x264)\n");
+    else if (ret != AVERROR(ENOSYS))
+        av_log(avctx, AV_LOG_VERBOSE, "RDK X5 hardware encoder unavailable, "
+               "using x264\n");
+    return ret;
+}
+#endif
+
 static av_cold int X264_init(AVCodecContext *avctx)
 {
     X264Context *x4 = avctx->priv_data;
@@ -1069,6 +1131,10 @@ static av_cold int X264_init(AVCodecContext *avctx)
     int sw,sh;
     int ret;
 
+#if CONFIG_X5MM
+    if (avctx->codec_id == AV_CODEC_ID_H264 && x264_x5_open(avctx) == 0)
+        return 0;
+#endif
     if (avctx->global_quality > 0)
         av_log(avctx, AV_LOG_WARNING, "-qscale is ignored, -crf is recommended.\n");
 
