+#ifndef AVCODEC_X5ENC_H
+#define AVCODEC_X5ENC_H
+
+#include "avcodec.h"
+
+typedef struct X5Enc X5Enc;
+
+typedef struct X5EncParams {
+    int qp;         /* >= 0: constant QP, else CBR at avctx->bit_rate */
+    int quality;    /* MJPEG quality factor */
+    int profile;    /* FF_PROFILE_* or FF_PROFILE_UNKNOWN */
+    int gop;        /* I frame interval when avctx->gop_size <= 0 */
+} X5EncParams;
+
+/* 1 unless X5_CODEC_DISABLE is set to a non-zero value */
+int ff_x5_enabled(void);
+
+/*
+ * Open a hardware encoder for avctx (codec_id, size, pix_fmt, rate).
+ * Fills avctx->extradata when AV_CODEC_FLAG_GLOBAL_HEADER is set.
+ * Returns < 0 if the hardware cannot take this configuration.
+ */
+int ff_x5enc_open(AVCodecContext *avctx, const X5EncParams *par, X5Enc **enc);
+
+/* encode2-style: exactly one packet per frame, nothing on flush */
+int ff_x5enc_encode(AVCodecContext *avctx, X5Enc *enc, AVPacket *pkt,
+                    const AVFrame *frame, int *got_packet);
+
+void ff_x5enc_close(X5Enc **enc);
+
