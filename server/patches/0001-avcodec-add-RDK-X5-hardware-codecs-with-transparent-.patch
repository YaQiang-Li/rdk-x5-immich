+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <stdlib.h>
+#include <string.h>
+
+#include <hb_media_codec.h>
+#include <hb_media_error.h>
+
+#include "config_components.h"
+
+#include "libavutil/imgutils.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+#include "avcodec.h"
+#include "codec_internal.h"
+#include "encode.h"
+#include "x5enc.h"
+
+#define X5ENC_TIMEOUT_MS 5000
+
+struct X5Enc {
+    media_codec_context_t mc;
+    int started;
+    int width, height;      /* coded size, see x5enc_coded_size() */
+};
+
+/*
+ * The VPU wants the width (and, to be safe, the height) to be a multiple
+ * of 8: portrait phone videos scaled to 720p are 540 or 406 wide. Encode
+ * the padded size and signal the real one with SPS cropping, which the
+ * VPU writes without touching the input. The JPU takes any size.
+ */
+static void x5enc_coded_size(AVCodecContext *avctx, int *w, int *h)
+{
+    if (avctx->codec_id == AV_CODEC_ID_MJPEG) {
+        *w = avctx->width;
+        *h = avctx->height;
+    } else {
+        *w = FFALIGN(avctx->width, 8);
+        *h = FFALIGN(avctx->height, 8);
+    }
+}
+
+int ff_x5_enabled(void)
+{
+    const char *e = getenv("X5_CODEC_DISABLE");
+
+    return !(e && *e && strcmp(e, "0"));
+}
+
+static int x5enc_set_rc(AVCodecContext *avctx, X5Enc *s,
+                        const X5EncParams *par)
+{
+    mc_rate_control_params_t *rc = &s->mc.video_enc_params.rc_params;
+    int is_h264 = avctx->codec_id == AV_CODEC_ID_H264;
+    int gop = avctx->gop_size > 0 ? avctx->gop_size : par->gop;
+    int fps = 30, kbps, ret;
+
+    if (avctx->framerate.num > 0 && avctx->framerate.den > 0)
+        fps = lrint(av_q2d(avctx->framerate));
+    else if (avctx->time_base.num > 0 && avctx->time_base.den > 0)
+        fps = lrint(av_q2d(av_inv_q(avctx->time_base)));
+    fps = av_clip(fps, 1, 240);
+
+    if (avctx->codec_id == AV_CODEC_ID_MJPEG)
+        rc->mode = MC_AV_RC_MODE_MJPEGFIXQP;
+    else if (par->qp >= 0)
+        rc->mode = is_h264 ? MC_AV_RC_MODE_H264FIXQP : MC_AV_RC_MODE_H265FIXQP;
+    else
+        rc->mode = is_h264 ? MC_AV_RC_MODE_H264CBR : MC_AV_RC_MODE_H265CBR;
+
+    /* fills in the library defaults for the selected mode */
+    ret = hb_mm_mc_get_rate_control_config(&s->mc, rc);
+    if (ret) {
+        av_log(avctx, AV_LOG_VERBOSE, "get rc config: 0x%x\n", ret);
+        return AVERROR_EXTERNAL;
+    }
+
+    /* no -b:v given: about 0.1 bit per pixel */
+    kbps = avctx->bit_rate > 0 ? avctx->bit_rate / 1000 :
+           (int64_t)avctx->width * avctx->height * fps / 10000;
+    kbps = av_clip(kbps, 1, 700000);
+
+#define SET_CBR(p) do {                                     \
+        (p).intra_period = gop;                             \
+        (p).frame_rate   = fps;                             \
+        (p).bit_rate     = kbps;                            \
+    } while (0)
+#define SET_FIXQP(p) do {                                   \
+        (p).intra_period = gop;                             \
+        (p).frame_rate   = fps;                             \
+        (p).force_qp_I   = par->qp;                         \
+        (p).force_qp_P   = par->qp;                         \
+        (p).force_qp_B   = par->qp;                         \
+    } while (0)
+
+    switch (rc->mode) {
+    case MC_AV_RC_MODE_H264CBR:   SET_CBR(rc->h264_cbr_params);     break;
+    case MC_AV_RC_MODE_H265CBR:   SET_CBR(rc->h265_cbr_params);     break;
+    case MC_AV_RC_MODE_H264FIXQP: SET_FIXQP(rc->h264_fixqp_params); break;
+    case MC_AV_RC_MODE_H265FIXQP: SET_FIXQP(rc->h265_fixqp_params); break;
+    default:
+        rc->mjpeg_fixqp_params.frame_rate     = fps;
+        rc->mjpeg_fixqp_params.quality_factor = par->quality;
+        break;
+    }
+    return 0;
+}
+
+/* signal the sample range; the library default marks streams full range */
+static int x5enc_set_vui(AVCodecContext *avctx, X5Enc *s)
+{
+    mc_video_vui_params_t vui = { 0 };
+    int full = avctx->color_range == AVCOL_RANGE_JPEG ||
+               avctx->pix_fmt == AV_PIX_FMT_YUVJ420P;
+    int ret;
+
+    ret = hb_mm_mc_get_vui_config(&s->mc, &vui);
+    if (ret)
+        goto fail;
+    /* sar must be valid even when aspect_ratio_info is not written */
+#define SET_VUI(v) do {                                     \
+        (v).sar_width  = FFMAX((v).sar_width,  1);          \
+        (v).sar_height = FFMAX((v).sar_height, 1);          \
+        (v).video_signal_type_present_flag = 1;             \
+        (v).video_format          = 5;                      \
+        (v).video_full_range_flag = full;                   \
+    } while (0)
+    if (s->mc.codec_id == MEDIA_CODEC_ID_H264)
+        SET_VUI(vui.h264_vui);
+    else
+        SET_VUI(vui.h265_vui);
+    ret = hb_mm_mc_set_vui_config(&s->mc, &vui);
+    if (!ret)
+        return 0;
+fail:
+    av_log(avctx, AV_LOG_VERBOSE, "VUI config: 0x%x\n", ret);
+    return AVERROR_EXTERNAL;
+}
+
+void ff_x5enc_close(X5Enc **enc)
+{
+    X5Enc *s = *enc;
+
+    if (!s)
+        return;
+    if (s->started) {
+        hb_mm_mc_stop(&s->mc);
+        hb_mm_mc_release(&s->mc);
+    }
+    av_freep(enc);
+}
+
+static int x5enc_open_hw(AVCodecContext *avctx, const X5EncParams *par,
+                         X5Enc *s)
+{
+    mc_video_codec_enc_params_t *p = &s->mc.video_enc_params;
+    mc_av_codec_startup_params_t startup = { 0 };
+    int ret;
+
+    s->mc.encoder = 1;
+    switch (avctx->codec_id) {
+    case AV_CODEC_ID_H264: s->mc.codec_id = MEDIA_CODEC_ID_H264;  break;
+    case AV_CODEC_ID_HEVC: s->mc.codec_id = MEDIA_CODEC_ID_H265;  break;
+    default:               s->mc.codec_id = MEDIA_CODEC_ID_MJPEG; break;
+    }
+
+    x5enc_coded_size(avctx, &s->width, &s->height);
+    p->width  = s->width;
+    p->height = s->height;
+    if (s->width != avctx->width || s->height != avctx->height) {
+        p->frame_cropping_flag = 1;
+        p->crop_rect.x_pos  = 0;
+        p->crop_rect.y_pos  = 0;
+        p->crop_rect.width  = avctx->width;
+        p->crop_rect.height = avctx->height;
+    }
+    p->pix_fmt = avctx->pix_fmt == AV_PIX_FMT_NV12 ?
+                 MC_PIXEL_FORMAT_NV12 : MC_PIXEL_FORMAT_YUV420P;
+    p->frame_buf_count     = 3;
+    p->external_frame_buf  = 0;
+    p->bitstream_buf_count = 3;
+    p->bitstream_buf_size  = FFALIGN(s->width * s->height * 3 / 2,
+                                     0x1000);
+    /*
+     * wave521cl: no B frames, single reference -> preset 9 (I-P-P-P, one
+     * reference). Preset 1 is all intra.
+     */
+    p->gop_params.gop_preset_idx = 9;
+    p->rot_degree      = MC_CCW_0;
+    p->mir_direction   = MC_DIRECTION_NONE;
+    p->enable_user_pts = 1;
+    if (s->mc.codec_id == MEDIA_CODEC_ID_H264) {
+        switch (par->profile) {
+        case AV_PROFILE_H264_BASELINE:
+        case AV_PROFILE_H264_CONSTRAINED_BASELINE:
+            p->h264_enc_config.h264_profile = MC_H264_PROFILE_BP;
+            break;
+        case AV_PROFILE_H264_MAIN:
+            p->h264_enc_config.h264_profile = MC_H264_PROFILE_MP;
+            break;
+        case AV_PROFILE_H264_HIGH:
+            p->h264_enc_config.h264_profile = MC_H264_PROFILE_HP;
+            break;
+        }
+    } else if (s->mc.codec_id == MEDIA_CODEC_ID_MJPEG) {
+        p->mjpeg_enc_config.restart_interval = avctx->width / 16;
+        if (avctx->pix_fmt == AV_PIX_FMT_NV12 &&
+            avctx->color_range != AVCOL_RANGE_JPEG)
+            av_log(avctx, AV_LOG_WARNING, "JPEG is full range but the "
+                   "NV12 input is not; use -vf scale=out_range=pc\n");
+    }
+
+    ret = x5enc_set_rc(avctx, s, par);
+    if (ret < 0)
+        return ret;
+
+    ret = hb_mm_mc_initialize(&s->mc);
+    if (ret) {
+        av_log(avctx, AV_LOG_VERBOSE, "hb_mm_mc_initialize: 0x%x\n", ret);
+        return AVERROR_EXTERNAL;
+    }
+    ret = hb_mm_mc_configure(&s->mc);
+    if (ret) {
+        av_log(avctx, AV_LOG_VERBOSE, "configure: 0x%x\n", ret);
+        hb_mm_mc_release(&s->mc);
+        return AVERROR_EXTERNAL;
+    }
+    s->started = 1;
+    if (s->mc.codec_id != MEDIA_CODEC_ID_MJPEG) {
+        ret = x5enc_set_vui(avctx, s);
+        if (ret < 0)
+            return ret;
+    }
+    ret = hb_mm_mc_start(&s->mc, &startup);
+    if (ret) {
+        av_log(avctx, AV_LOG_VERBOSE, "start: 0x%x\n", ret);
+        return AVERROR_EXTERNAL;
+    }
+    return 0;
+}
+
+/* returns the NAL type of an Annex B NAL starting at buf (after 00 00 01) */
+static int x5enc_nal_type(enum AVCodecID id, uint8_t b)
+{
+    return id == AV_CODEC_ID_H264 ? b & 0x1f : (b >> 1) & 0x3f;
+}
+
+static int x5enc_is_key(AVCodecContext *avctx, const uint8_t *buf, int size)
+{
+    int i;
+
+    if (avctx->codec_id == AV_CODEC_ID_MJPEG)
+        return 1;
+    for (i = 0; i + 3 < size; i++) {
+        int t;
+
+        if (buf[i] || buf[i + 1] || buf[i + 2] != 1)
+            continue;
+        t = x5enc_nal_type(avctx->codec_id, buf[i + 3]);
+        if (avctx->codec_id == AV_CODEC_ID_H264) {
+            if (t == 5)
+                return 1;
+            if (t >= 1 && t <= 4)
+                return 0;
+        } else {
+            if (t >= 16 && t <= 21)
+                return 1;
+            if (t < 16)
+                return 0;
+        }
+    }
+    return 0;
+}
+
+/* replicate the last column and row of a w x h plane up to aw x ah */
+static void x5enc_pad_plane(uint8_t *p, int stride, int w, int h,
+                            int aw, int ah, int bpp)
+{
+    int x, y;
+
+    if (aw > w)
+        for (y = 0; y < h; y++) {
+            uint8_t *row = p + y * stride;
+
+            for (x = w; x < aw; x++)
+                memcpy(row + x * bpp, row + (w - 1) * bpp, bpp);
+        }
+    for (y = h; y < ah; y++)
+        memcpy(p + y * stride, p + (h - 1) * stride, aw * bpp);
+}
+
+/* copy f into the w x h coded buffer (w, h >= the frame size) */
+static void x5enc_copy_frame(mc_video_frame_buffer_info_t *vf,
+                             const AVFrame *f, int aw, int ah)
+{
+    int w = f->width, h = f->height;
+    int ls = vf->stride > 0 ? vf->stride : aw;
+    int cs = ls / 2;
+    int pad = aw != w || ah != h;
+
+    av_image_copy_plane(vf->vir_ptr[0], ls, f->data[0], f->linesize[0],
+                        w, h);
+    if (pad)
+        x5enc_pad_plane(vf->vir_ptr[0], ls, w, h, aw, ah, 1);
+    if (f->format == AV_PIX_FMT_NV12) {
+        av_image_copy_plane(vf->vir_ptr[1], ls, f->data[1], f->linesize[1],
+                            w, h / 2);
+        if (pad)
+            x5enc_pad_plane(vf->vir_ptr[1], ls, w / 2, h / 2,
+                            aw / 2, ah / 2, 2);
+        return;
+    }
+    av_image_copy_plane(vf->vir_ptr[1], cs, f->data[1], f->linesize[1],
+                        w / 2, h / 2);
+    av_image_copy_plane(vf->vir_ptr[2], cs, f->data[2], f->linesize[2],
+                        w / 2, h / 2);
+    if (pad) {
+        x5enc_pad_plane(vf->vir_ptr[1], cs, w / 2, h / 2, aw / 2, ah / 2, 1);
+        x5enc_pad_plane(vf->vir_ptr[2], cs, w / 2, h / 2, aw / 2, ah / 2, 1);
+    }
+}
+
+int ff_x5enc_encode(AVCodecContext *avctx, X5Enc *s, AVPacket *pkt,
+                    const AVFrame *f, int *got_packet)
+{
+    media_codec_buffer_t in = { 0 }, out = { 0 };
+    media_codec_output_buffer_info_t info = { 0 };
+    int ret;
+
+    *got_packet = 0;
+    if (!f)
+        return 0;
+
+    if (f->pict_type == AV_PICTURE_TYPE_I &&
+        s->mc.codec_id != MEDIA_CODEC_ID_MJPEG)
+        hb_mm_mc_request_idr_frame(&s->mc);
+
+    /* the VPU/JPU emits exactly one packet per frame (no B frames) */
+    in.type = MC_VIDEO_FRAME_BUFFER;
+    ret = hb_mm_mc_dequeue_input_buffer(&s->mc, &in, X5ENC_TIMEOUT_MS);
+    if (ret) {
+        av_log(avctx, AV_LOG_ERROR, "dequeue input: 0x%x\n", ret);
+        return AVERROR_EXTERNAL;
+    }
+    x5enc_copy_frame(&in.vframe_buf, f, s->width, s->height);
+    in.type = MC_VIDEO_FRAME_BUFFER;
+    in.vframe_buf.width   = s->width;
+    in.vframe_buf.height  = s->height;
+    in.vframe_buf.pix_fmt = s->mc.video_enc_params.pix_fmt;
+    in.vframe_buf.pts     = f->pts;
+    ret = hb_mm_mc_queue_input_buffer(&s->mc, &in, X5ENC_TIMEOUT_MS);
+    if (ret) {
+        av_log(avctx, AV_LOG_ERROR, "queue input: 0x%x\n", ret);
+        return AVERROR_EXTERNAL;
+    }
+
+    ret = hb_mm_mc_dequeue_output_buffer(&s->mc, &out, &info,
+                                         X5ENC_TIMEOUT_MS);
+    if (ret) {
+        av_log(avctx, AV_LOG_ERROR, "dequeue output: 0x%x\n", ret);
+        return AVERROR_EXTERNAL;
+    }
+    ret = ff_get_encode_buffer(avctx, pkt, out.vstream_buf.size, 0);
+    if (!ret) {
+        memcpy(pkt->data, out.vstream_buf.vir_ptr, out.vstream_buf.size);
+        pkt->pts      = pkt->dts = f->pts;
+        pkt->duration = f->duration;
+        if (x5enc_is_key(avctx, pkt->data, pkt->size))
+            pkt->flags |= AV_PKT_FLAG_KEY;
+        /* one packet per frame: carry the frame opaque like encode.c does */
+        ret = ff_encode_reordered_opaque(avctx, pkt, f);
+        *got_packet = ret >= 0;
+    }
+    if (hb_mm_mc_queue_output_buffer(&s->mc, &out, X5ENC_TIMEOUT_MS))
+        av_log(avctx, AV_LOG_WARNING, "queue output buffer failed\n");
+    return ret;
+}
+
+/*
+ * The library puts parameter sets in front of each IDR frame only. To get
+ * them up front, encode one gray frame on a scratch instance with the same
+ * settings and keep its VPS/SPS/PPS.
+ */
+static int x5enc_get_headers(AVCodecContext *avctx, const X5EncParams *par)
+{
+    enum AVCodecID id = avctx->codec_id;
+    X5Enc *tmp = av_mallocz(sizeof(*tmp));
+    AVFrame *f = av_frame_alloc();
+    AVPacket *pkt = av_packet_alloc();
+    int ret, got = 0, i, start = -1, n = 0;
+    uint8_t *ex;
+
+    if (!tmp || !f || !pkt) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+    f->format = avctx->pix_fmt;
+    f->width  = avctx->width;
+    f->height = avctx->height;
+    ret = av_frame_get_buffer(f, 0);
+    if (ret < 0)
+        goto end;
+    for (i = 0; i < 4 && f->data[i]; i++)
+        memset(f->data[i], 128, f->linesize[i] *
+               (i ? AV_CEIL_RSHIFT(f->height, 1) : f->height));
+    f->pts = 0;
+
+    ret = x5enc_open_hw(avctx, par, tmp);
+    if (!ret)
+        ret = ff_x5enc_encode(avctx, tmp, pkt, f, &got);
+    if (ret < 0 || !got) {
+        ret = ret < 0 ? ret : AVERROR_EXTERNAL;
+        goto end;
+    }
+
+    ex = av_mallocz(pkt->size + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!ex) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+    /* copy the leading parameter set NALs, with their start codes */
+    for (i = 0; i + 3 <= pkt->size; i++) {
+        int t;
+
+        if (i + 3 < pkt->size && !pkt->data[i] && !pkt->data[i + 1] &&
+            pkt->data[i + 2] == 1) {
+            int sc = i > 0 && !pkt->data[i - 1] ? i - 1 : i;
+
+            if (start >= 0) {
+                memcpy(ex + n, pkt->data + start, sc - start);
+                n += sc - start;
+                start = -1;
+            }
+            t = x5enc_nal_type(id, pkt->data[i + 3]);
+            if (id == AV_CODEC_ID_H264 ? (t == 7 || t == 8) :
+                                         (t >= 32 && t <= 34))
+                start = sc;
+            else if (id == AV_CODEC_ID_H264 ? (t >= 1 && t <= 5) : t < 32)
+                break;
+            i += 2;
+        }
+    }
+    if (!n) {
+        av_free(ex);
+        ret = AVERROR_EXTERNAL;
+        goto end;
+    }
+    av_freep(&avctx->extradata);
+    avctx->extradata      = ex;
+    avctx->extradata_size = n;
+    ret = 0;
+end:
+    ff_x5enc_close(&tmp);
+    av_frame_free(&f);
+    av_packet_free(&pkt);
+    return ret;
+}
+
+int ff_x5enc_open(AVCodecContext *avctx, const X5EncParams *par, X5Enc **enc)
+{
+    X5Enc *s;
+    int ret;
+
+    *enc = NULL;
+    if (!ff_x5_enabled())
+        return AVERROR(ENOSYS);
+    if (avctx->pix_fmt != AV_PIX_FMT_NV12 &&
+        avctx->pix_fmt != AV_PIX_FMT_YUV420P &&
+        avctx->pix_fmt != AV_PIX_FMT_YUVJ420P)
+        return AVERROR(ENOSYS);
+    if ((avctx->width | avctx->height) & 1)
+        return AVERROR(ENOSYS);
+
+    if ((avctx->flags & AV_CODEC_FLAG_GLOBAL_HEADER) &&
+        avctx->codec_id != AV_CODEC_ID_MJPEG) {
+        ret = x5enc_get_headers(avctx, par);
+        if (ret < 0)
+            return ret;
+    }
+
+    s = av_mallocz(sizeof(*s));
+    if (!s)
+        return AVERROR(ENOMEM);
+    ret = x5enc_open_hw(avctx, par, s);
+    if (ret < 0) {
+        ff_x5enc_close(&s);
+        return ret;
+    }
+    avctx->has_b_frames = 0;
+    *enc = s;
+    return 0;
+}
+
+/* ---- standalone h264_x5 / hevc_x5 / mjpeg_x5 encoders ---- */
+
+typedef struct X5EncCodecContext {
+    const AVClass *class;
+    X5Enc *enc;
+    int qp;
+    int quality;
+} X5EncCodecContext;
+
+static av_cold int x5enc_init(AVCodecContext *avctx)
+{
+    X5EncCodecContext *c = avctx->priv_data;
+    X5EncParams par = {
+        .qp      = c->qp,
+        .quality = c->quality,
+        .profile = avctx->profile,
+        .gop     = 60,
+    };
+    int ret = ff_x5enc_open(avctx, &par, &c->enc);
+
+    if (ret == AVERROR(ENOSYS))
+        av_log(avctx, AV_LOG_ERROR, "hardware encoder disabled or input "
+               "not supported (needs nv12/yuv420p, even size)\n");
+    else if (ret < 0)
+        av_log(avctx, AV_LOG_ERROR, "hardware encoder open failed\n");
+    return ret;
+}
+
+static int x5enc_encode2(AVCodecContext *avctx, AVPacket *pkt,
+                         const AVFrame *frame, int *got_packet)
+{
+    X5EncCodecContext *c = avctx->priv_data;
+
+    return ff_x5enc_encode(avctx, c->enc, pkt, frame, got_packet);
+}
+
+static av_cold int x5enc_close(AVCodecContext *avctx)
+{
+    X5EncCodecContext *c = avctx->priv_data;
+
+    ff_x5enc_close(&c->enc);
+    return 0;
+}
+
+#define OFFSET(x) offsetof(X5EncCodecContext, x)
+#define VE AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_ENCODING_PARAM
+static const AVOption x5enc_options[] = {
+    { "qp", "constant QP (0-51); enables FIXQP instead of CBR",
+      OFFSET(qp), AV_OPT_TYPE_INT, { .i64 = -1 }, -1, 51, VE },
+    { NULL }
+};
+
+static const AVOption x5enc_mjpeg_options[] = {
+    { "quality", "JPEG quality factor (0-100)",
+      OFFSET(quality), AV_OPT_TYPE_INT, { .i64 = 85 }, 0, 100, VE },
+    { NULL }
+};
+
+static const FFCodecDefault x5enc_defaults[] = {
+    { "b", "0" },
+    { "g", "60" },
+    { NULL },
+};
+
+static const enum AVPixelFormat x5enc_pix_fmts[] = {
+    AV_PIX_FMT_NV12, AV_PIX_FMT_YUV420P, AV_PIX_FMT_NONE
+};
+
+/* JPEG is full range by convention: yuv420p input gets range-expanded */
+static const enum AVPixelFormat x5enc_mjpeg_pix_fmts[] = {
+    AV_PIX_FMT_YUVJ420P, AV_PIX_FMT_NV12, AV_PIX_FMT_NONE
+};
+
+#define X5ENC(NAME, LONGNAME, ID, OPTS, FMTS)                               \
+    static const AVClass x5_##NAME##_enc_class = {                          \
+        .class_name = #NAME "_x5_encoder",                                  \
+        .item_name  = av_default_item_name,                                 \
+        .option     = OPTS,                                                 \
+        .version    = LIBAVUTIL_VERSION_INT,                                \
+    };                                                                      \
+    const FFCodec ff_##NAME##_x5_encoder = {                                \
+        .p.name         = #NAME "_x5",                                      \
+        CODEC_LONG_NAME("RDK X5 " LONGNAME " hardware encoder"),            \
+        .p.type         = AVMEDIA_TYPE_VIDEO,                               \
+        .p.id           = ID,                                               \
+        .p.priv_class   = &x5_##NAME##_enc_class,                           \
+        .p.capabilities = AV_CODEC_CAP_HARDWARE |                           \
+                          AV_CODEC_CAP_ENCODER_REORDERED_OPAQUE,            \
+        .p.pix_fmts     = FMTS,                                             \
+        .p.wrapper_name = "x5mm",                                           \
+        .priv_data_size = sizeof(X5EncCodecContext),                        \
+        .init           = x5enc_init,                                       \
+        FF_CODEC_ENCODE_CB(x5enc_encode2),                                  \
+        .close          = x5enc_close,                                      \
+        .defaults       = x5enc_defaults,                                   \
+        .color_ranges   = AVCOL_RANGE_MPEG | AVCOL_RANGE_JPEG,              \
+        .caps_internal  = FF_CODEC_CAP_INIT_CLEANUP,                        \
+    };
+
+#if CONFIG_H264_X5_ENCODER
+X5ENC(h264,  "H.264", AV_CODEC_ID_H264,  x5enc_options, x5enc_pix_fmts)
+#endif
+#if CONFIG_HEVC_X5_ENCODER
+X5ENC(hevc,  "HEVC",  AV_CODEC_ID_HEVC,  x5enc_options, x5enc_pix_fmts)
+#endif
+#if CONFIG_MJPEG_X5_ENCODER
+X5ENC(mjpeg, "MJPEG", AV_CODEC_ID_MJPEG, x5enc_mjpeg_options,
+      x5enc_mjpeg_pix_fmts)
+#endif
