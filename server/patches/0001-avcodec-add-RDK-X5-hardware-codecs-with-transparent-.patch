+static int x265_x5_open(AVCodecContext *avctx)
+{
+    libx265Context *x = avctx->priv_data;
+    X5EncParams par = {
+        .qp      = -1,
+        .profile = avctx->profile,
+        .gop     = 250,
+    };
+    int ret;
+
+    if (x->cqp == 0 || x->crf == 0)
